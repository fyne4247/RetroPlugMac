IPLUG2_ROOT = ../thirdparty/iPlug2
#include "../thirdparty/iPlug2/common-mac.xcconfig"

//------------------------------
// Global build settings

// the basename of the vst, vst3, app, component, aaxplugin
BINARY_NAME = RetroPlug

// ------------------------------
// HEADER AND LIBRARY SEARCH PATHS
EXTRA_INC_PATHS = $(IGRAPHICS_INC_PATHS)
EXTRA_LIB_PATHS = $(IGRAPHICS_LIB_PATHS)
EXTRA_LNK_FLAGS = //$(IGRAPHICS_LNK_FLAGS)

EXTRA_APP_DEFS = RAPIDJSON_HAS_STDSTRING=1
EXTRA_PLUGIN_DEFS = RAPIDJSON_HAS_STDSTRING=1

//------------------------------
// PREPROCESSOR MACROS
EXTRA_ALL_DEFS = OBJC_PREFIX=vRetroPlug SWELL_APP_PREFIX=Swell_vRetroPlug IGRAPHICS_NANOVG IGRAPHICS_GL2
//EXTRA_DEBUG_DEFS =
//EXTRA_RELEASE_DEFS =
//EXTRA_TRACER_DEFS =

//------------------------------
// RELEASE BUILD OPTIONS

//Enable/Disable Profiling code
PROFILE = NO //NO, YES - enable this if you want to use instruments to profile a plugin

// Optimization level -
// None: [-O0] Fast: [-O, -O1] Faster:[-O2] Fastest: [-O3] Fastest, smallest: Optimize for size. [-Os]
RELEASE_OPTIMIZE = 3 //0,1,2,3,s

//------------------------------
// DEBUG BUILD OPTIONS
DEBUG_OPTIMIZE = 0 //0,1,2,3,s

//------------------------------
// MISCELLANEOUS COMPILER OPTIONS

//ARCHS = $(ARCHS_STANDARD_32_64_BIT)
// Native arch on Apple Silicon is arm64; ARCHS_STANDARD_64_BIT resolves correctly
// under modern Xcode (arm64 on AS Macs, x86_64 under Rosetta).
ARCHS = $(ARCHS_STANDARD_64_BIT)
ONLY_ACTIVE_ARCH = YES

GCC_INCREASE_PRECOMPILED_HEADER_SHARING = NO

// Flags to pass to compiler for all builds.
// NOTE: Do not pass -msse / -mavx here — those are x86-only and break arm64 builds.
// SSE-style code paths (if any) should be gated with runtime/arch checks instead.
GCC_CFLAGS = -Wno-write-strings

// Uncomment to enable relaxed IEEE compliance
//GCC_FAST_MATH = YES

// uncomment this to enable codesigning - necessary for AUv3 delivery
//CODE_SIGN_IDENTITY=Mac Developer
